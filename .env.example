# Golf Utah Backend — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ─── SERVER ───────────────────────────────────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:3000   # or your deployed frontend URL

# ─── TWILIO (SMS ALERTS) ──────────────────────────────────────────────────────
# Sign up at twilio.com — takes 5 minutes, free trial included
# After signup: Console Dashboard → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+18015551234     # the Twilio phone number you buy (~$1/month)

# ─── LIGHTSPEED / CHRONOGOLF PARTNER API (optional — add when approved) ───────
# Leave blank until Lightspeed approves your Partner API application
CHRONOGOLF_CLIENT_ID=
CHRONOGOLF_CLIENT_SECRET=
CHRONOGOLF_REFRESH_TOKEN=

# ─── DATABASE (optional for v1 — alerts use in-memory store by default) ───────
# Add a Postgres URL when you're ready to persist users and alerts
# Railway and Render both provide free Postgres instances
DATABASE_URL=postgresql://user:password@host:5432/golfutah

# ─── REDIS (optional — for production caching) ────────────────────────────────
REDIS_URL=redis://localhost:6379
